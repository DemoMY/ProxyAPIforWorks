# llm-gate configuration — copy to .env and adjust
# Each line below is OPTIONAL — sensible defaults apply if unset.

# Where SQLite, master encryption key and runtime data live.
# LLM_GATE_DATA_DIR=~/.llm-gate

# Listen address. Default 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to expose externally — REQUIRES LLM_GATE_AUTH_TOKEN.
# LLM_GATE_HOST=127.0.0.1

# Ports.
# LLM_GATE_UI_PORT=7777
# LLM_GATE_PROXY_PORT=8082

# Bearer token required on both ports (except /health and /api/health).
# Generate one with: openssl rand -hex 32
# REQUIRED if LLM_GATE_HOST is not loopback.
# LLM_GATE_AUTH_TOKEN=

# Upstream request timeout in milliseconds (combined with the client's signal).
# LLM_GATE_UPSTREAM_TIMEOUT_MS=120000

# How often the background health-check runs (proxies + keys).
# LLM_GATE_HEALTH_INTERVAL_MS=300000

# Custom Ollama base URL (default localhost). Useful if Ollama is on another host.
# LLM_GATE_OLLAMA_URL=http://127.0.0.1:11434/v1

# Fastify log level: trace / debug / info / warn / error.
# LLM_GATE_LOG_LEVEL=info
