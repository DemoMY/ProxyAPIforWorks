{
  "name": "llm-gate",
  "version": "0.1.0",
  "description": "Self-hosted OpenAI-compatible proxy for free LLM providers with per-provider HTTP/SOCKS proxy support, key auto-rotation and health checks.",
  "type": "module",
  "bin": {
    "llm-gate": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.json && cp -r src/ui dist/ui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "socks": "^2.8.3",
    "undici": "^6.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
